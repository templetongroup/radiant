<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ⚠️ THIS IS EMBEDDED INTO THE HELPER BINARY, not shipped beside it. A bare
  Mach-O has no bundle, so Bundle.main.infoDictionary is nil and the Speech and
  AVFoundation frameworks refuse to ask for permission at all — the process is
  killed for "accessing privacy-sensitive data without a usage description".

  package.json links it in with:
    -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker native/Info.plist

  Probed on 2026-09-03 before any of this was written: with the section present,
  Bundle.main reads NSMicrophoneUsageDescription, SFSpeechRecognizer builds, and
  supportsOnDeviceRecognition is true. Radiant.app carries the same two strings
  (electron-builder extendInfo) because the prompt the user actually sees is
  attributed to the app that spawned the helper.
-->
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>com.tonyricciardi.radiant.control</string>
  <key>CFBundleName</key><string>Radiant Control</string>
  <key>NSMicrophoneUsageDescription</key><string>Radiant turns what you say into text in the message box. Audio is transcribed on this Mac and is never sent anywhere.</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>Radiant transcribes your dictation on this Mac, using Apple's on-device speech recognition. Nothing is sent to Apple or to any server.</string>
</dict></plist>
