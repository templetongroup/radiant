# ⚠️ save-exact IS REAL; min-release-age IS NOT (on npm).
#
# Pi's hardening notes suggest `.npmrc` carrying `save-exact=true` and
# `min-release-age=2`. Only the first is an npm setting — npm 10.9.8 does not
# recognise min-release-age (it is pnpm's `minimumReleaseAge`), and npm silently
# ignores keys it does not know. Copying it here would have looked like a
# control while doing nothing at all.
#
# The two-day rule is enforced for real in scripts/test-supply-chain.mjs, which
# asks the registry when each installed version was published.
save-exact=true
