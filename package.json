{
  "name": "radiant",
  "version": "0.6.232",
  "private": true,
  "description": "Radiant — a local coding harness: chat with coding agents across cloud and local models.",
  "author": "Tony Ricciardi",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,ui \"node server/index.js\" \"vite --port 5833 --strictPort\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "compile:helper": "swiftc -O native/RadiantControl.swift -o native/radiant-control -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker native/Info.plist",
    "app": "npm run build && electron .",
    "dist": "npm run build && npm run compile:helper && electron-builder --mac",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true",
    "release": "node scripts/release.mjs",
    "test:smoke": "node scripts/test-smoke.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:contrast": "node scripts/test-contrast.mjs",
    "test:supply": "node scripts/test-supply-chain.mjs",
    "catalog:export": "python3 scripts/catalog-export.py",
    "catalog:check": "python3 scripts/catalog-check.py",
    "catalog:publish": "npm run catalog:export && npm run catalog:check && cp apps/ios/catalog.json ~/Projects/templeton-group-dev-website/showcase/radiant/catalog.json && echo \"  copied — commit and push the website to publish\""
  },
  "build": {
    "appId": "com.tonyricciardi.radiant",
    "productName": "Radiant",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterSign": "build/notarize-hook.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "templetongroup",
        "repo": "radiant"
      }
    ],
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/radiant-control",
        "to": "native/radiant-control"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/playwright-core/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ],
      "identity": "Anthony Ricciardi (5VY66S6G3M)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Radiant turns what you say into text in the message box. Audio is transcribed on this Mac and is never sent anywhere.",
        "NSSpeechRecognitionUsageDescription": "Radiant transcribes your dictation on this Mac, using Apple's on-device speech recognition. Nothing is sent to Apple or to any server."
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dompurify": "3.4.13",
    "electron-updater": "6.8.9",
    "express": "4.22.2",
    "mermaid": "11.17.1",
    "node-pty": "1.1.0",
    "playwright-core": "1.62.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "concurrently": "9.2.4",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "highlight.js": "11.12.0",
    "marked": "15.0.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.4.3"
  }
}
